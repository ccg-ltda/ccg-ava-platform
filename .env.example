# =============================================================================
# Example environment. Copy to .env and adjust. Values below are for DEVELOPMENT ONLY:
# never reuse them in production, and never commit your real .env.
# Host names (postgres, redis, minio, reverb) are the Docker service names of docker-compose.yml.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="CCG Ava Platform"
APP_ENV=local
# Required. Generate one (see INFRASTRUCTURE.md) or run: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance mode shared across replicas in production: APP_MAINTENANCE_DRIVER=cache + APP_MAINTENANCE_STORE=redis
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=redis

# Behind a load balancer: "*" or a comma-separated list of proxy IPs. Empty = trust none.
# TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# Native runs (outside Docker) can use DB_HOST=127.0.0.1 and DB_PORT=5433 (DB_FORWARD_PORT).
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ccg_ava
DB_USERNAME=ccg
DB_PASSWORD=secret

# -----------------------------------------------------------------------------
# Redis (cache, queues, sessions, Reverb bus)
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
# CACHE_PREFIX=
QUEUE_CONNECTION=redis

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# -----------------------------------------------------------------------------
# File storage (S3-compatible)
# Local: MinIO (API http://localhost:9000, no web console).
# Production: DigitalOcean Spaces, e.g. AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com,
#             AWS_DEFAULT_REGION=nyc3, AWS_USE_PATH_STYLE_ENDPOINT=false.
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=ccg-ava
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/ccg-ava
AWS_USE_PATH_STYLE_ENDPOINT=true

# MinIO container (local only)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# -----------------------------------------------------------------------------
# Realtime (Reverb websockets)
# REVERB_HOST / REVERB_PORT is how the app reaches the Reverb server inside Docker.
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=ccg-ava
REVERB_APP_KEY=ccg-ava-key
REVERB_APP_SECRET=ccg-ava-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=true

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
# "Recordar sesión" recuerda el último correo y Workspace durante estos minutos (30 días); nunca la contraseña.
AUTH_REMEMBERED_ACCESS_MINUTES=43200

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Initial administrator (database/seeders/AdminUserSeeder.php)
# Development values. In production the seeder refuses passwords shorter than 12 characters.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@ava.com
ADMIN_PASSWORD=Admin123*
# ADMIN_NAME=Administrador

# Code of the administrative Workspace of Ava Platform (the internal operations Workspace).
# WORKSPACE_ADMIN_CODE=DESARROLLO_DEV

# -----------------------------------------------------------------------------
# Docker (development)
# -----------------------------------------------------------------------------
APP_PORT=8000
VITE_PORT=5173
DB_FORWARD_PORT=5433
MINIO_PORT=9000
# Run migrations automatically when the app container starts. Development only.
RUN_MIGRATIONS=true

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# Integraciones: permitir conexiones a hosts privados (solo desarrollo con una API mock; false en producción)
INTEGRATIONS_ALLOW_PRIVATE_HOSTS=false

# WhatsApp Business: API de Meta con la que Ava verifica un número (solo lectura)
# WHATSAPP_GRAPH_URL=https://graph.facebook.com
# WHATSAPP_GRAPH_VERSION=v25.0

# n8n de la plataforma (motor provisional de los chatbots). Sin URL y secreto no se ejecuta ningún workflow.
# N8N_EXECUTION_URL=https://n8n.example.com/webhook
# N8N_EXECUTION_SECRET=
# N8N_EXECUTION_TIMEOUT=25

# App de Meta que posee los números de WhatsApp: el webhook /api/webhooks/whatsapp solo existe si ambos valores están definidos.
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
